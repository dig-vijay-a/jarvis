# NOVA Operating System Environment Configuration

PORT=5000
NODE_ENV=development

# Google Gemini API Key (Optional but recommended for full reasoning)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Local LLM (Optional)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Python Local Automation Agent
PYTHON_AGENT_URL=http://localhost:8000
PYTHON_AGENT_TOKEN=nova-local-agent-secure-token-2026

# User Identity
SYSTEM_USER_NAME=Commander Digvijay
