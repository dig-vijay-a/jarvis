# JARVIS OS 2.0 — Environment Configuration Template
# Copy or edit .env and paste API keys for the providers you want to enable.

# ==========================================
# PRIMARY LOCAL AI (Zero-Cost Policy Default)
# ==========================================
ZERO_COST_LOCAL_ONLY=true
PRIMARY_AI_PROVIDER=ollama
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NO_CLOUD=1
LOCAL_INFERENCE_TIMEOUT_MS=120000

# ==========================================
# OPTIONAL CLOUD AI PROVIDERS (Disabled by default when ZERO_COST_LOCAL_ONLY=true)
# ==========================================
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# ==========================================
# SERVER & PYTHON LOCAL AGENT
# ==========================================
PORT=5000
NODE_ENV=development
PYTHON_AGENT_URL=http://127.0.0.1:8000
PYTHON_AGENT_MODE=auto
JARVIS_AGENT_TOKEN=
NOVA_AGENT_TOKEN=
NOVA_MASTER_SECRET=
MISSION_MAX_WORKERS=4
